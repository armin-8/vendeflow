# VendeFlow - Git Ignore

# ═══════════════════════════════════════════════════════════
# PYTHON / BACKEND
# ═══════════════════════════════════════════════════════════

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/

# Database
*.db
*.sqlite3

# Environment variables
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# ═══════════════════════════════════════════════════════════
# JAVASCRIPT / FRONTEND
# ═══════════════════════════════════════════════════════════

# Dependencies
node_modules/

# Build
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# ═══════════════════════════════════════════════════════════
# PROYECTO ESPECÍFICO
# ═══════════════════════════════════════════════════════════

# NOTA: las migraciones SÍ se versionan. Antes había un `migrations/` aquí con
# un `!migrations/versions/` debajo, pero git no entra a un directorio ya
# excluido, así que la negación nunca aplicaba y las migraciones quedaban fuera
# del repo.

# Archivos temporales
*.tmp
*.temp
*.log

# Coverage reports
htmlcov/
.coverage
coverage.xml
