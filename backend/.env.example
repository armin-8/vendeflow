# VendeFlow - Variables de Entorno
# Copia este archivo como .env y configura tus valores

# Flask
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=tu-clave-secreta-aqui-cambiar-en-produccion

# JWT
JWT_SECRET_KEY=tu-jwt-secret-key-cambiar-en-produccion

# Database
DATABASE_URL=postgresql://usuario:password@localhost:5432/vendeflow
# Para desarrollo local con SQLite:
# DATABASE_URL=sqlite:///vendeflow.db

# CORS
FRONTEND_URL=http://localhost:5173
